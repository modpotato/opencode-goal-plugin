  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "goal.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "beta",
    "zod": "^4.1.8",
    "effect": "4.0.0-beta.59"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
